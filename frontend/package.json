{
  "name": "@kg/frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "app:sync": "npm run build && cap sync android",
    "app:open": "cap open android",
    "app:build": "node scripts/app-build.mjs",
    "app:dev": "cap run android --live-reload --external --port 5173",
    "app:assets": "node scripts/gen-assets.mjs && capacitor-assets generate --android --iconBackgroundColor \"#FFFFFF\" --splashBackgroundColor \"#FFA723\" && node scripts/patch-icons.mjs",
    "store:assets": "node scripts/gen-store-assets.mjs"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor-community/privacy-screen": "^8.0.0",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/network": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capawesome/capacitor-app-update": "^8.1.1",
    "@kg/shared": "*",
    "@react-three/drei": "^9.117.0",
    "@react-three/fiber": "^8.17.10",
    "@tanstack/react-query": "^5.59.0",
    "axios": "^1.7.7",
    "canvas-confetti": "^1.9.3",
    "framer-motion": "^11.11.17",
    "gsap": "^3.12.5",
    "howler": "^2.2.4",
    "idb-keyval": "^6.3.0",
    "lottie-react": "^2.4.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3",
    "three": "^0.169.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@types/canvas-confetti": "^1.6.4",
    "@types/howler": "^2.2.12",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.20.5"
  }
}
