# backend/.env.example  (set in Vercel > krishna-gurukul-api > Environment Variables)
# Leave any key empty and that service runs in MOCK mode (see README).
MONGODB_URI=                 # empty in dev = embedded in-memory/persistent Mongo (.data/mongo)
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
CRON_SECRET=                 # Vercel sends it as Bearer token to /api/cron/*
APP_URL=http://localhost:5173
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=
B2_ENDPOINT=
B2_REGION=
B2_PUBLIC_URL=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Krishna Gurukul
OFFICE_EMAIL=krishnagurukul2022@gmail.com
GROQ_API_KEYS=key1,key2,key3,key4,key5,key6,key7,key8,key9,key10
GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Firebase Cloud Messaging (empty = push is only logged to the console)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Play App Signing SHA-256 fingerprint(s), comma separated, for /.well-known/assetlinks.json
ANDROID_CERT_SHA256=
# off = admin password login only (dev). Use 'on' in production.
ADMIN_DEVICE_OTP=on
